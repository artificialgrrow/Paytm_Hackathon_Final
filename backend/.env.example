# Paytm AI Hub - Sponsor & AI API Keys (Hackathon Mumbai)

# 1. SerpApi (Google Flights, Shopping, Local Discovery)
SERPAPI_KEY=your_serpapi_key_here

# 2. You.com API (Live Citations & Policy Verification)
YOU_API_KEY=your_youcom_api_key_here

# 3. Nexconn Chat SDK (Real-Time Dispute Support Chat)
NEXCONN_API_KEY=your_nexconn_api_key_here

# 4. Optional Fast LLM (Groq / Gemini / OpenAI)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# 5. Optional Custom CORS Domain (comma-separated, https://*.vercel.app is already allowed by default)
CORS_ORIGINS=https://your-custom-domain.com
